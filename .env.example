# Docker Compose local-only configuration. Copy to .env and change passwords if
# the database is reachable by any user other than you.
POSTGRES_DB=olist_source
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=local_admin_change_me
POSTGRES_PORT=5432

SOURCE_LOADER_USER=olist_loader
SOURCE_LOADER_PASSWORD=local_loader_change_me
SOURCE_READER_USER=olist_reader
SOURCE_READER_PASSWORD=local_reader_change_me

# Simulator host CLI reads the shell environment, not this file automatically.
# Export SOURCE_SIMULATOR_DSN or standard PG* variables before applying batches.
# Example with these default local credentials:
# export SOURCE_SIMULATOR_DSN='postgresql://olist_loader:local_loader_change_me@127.0.0.1:5432/olist_source'

# TODO(phase-0): Add MinIO and Airflow variables together with those services;
# do not create unused credentials in advance.
