# Docker Compose local-only configuration. Copy to .env and change passwords if
# the database is reachable by any user other than you.
POSTGRES_DB=olist_source
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=local_admin_change_me
POSTGRES_PORT=5432

SOURCE_LOADER_USER=olist_loader
SOURCE_LOADER_PASSWORD=local_loader_change_me
SOURCE_READER_USER=olist_reader
SOURCE_READER_PASSWORD=local_reader_change_me

# Simulator host CLI reads the shell environment, not this file automatically.
# Export SOURCE_SIMULATOR_DSN or standard PG* variables before applying batches.
# Example with these default local credentials:
# export SOURCE_SIMULATOR_DSN='postgresql://olist_loader:local_loader_change_me@127.0.0.1:5432/olist_source'

MINIO_ROOT_USER=olist_minio_admin
MINIO_ROOT_PASSWORD=local_minio_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bronze host CLI reads process environment; export these explicitly.
# export BRONZE_SOURCE_DSN='postgresql://olist_loader:local_loader_change_me@127.0.0.1:5432/olist_source'
# export BRONZE_S3_ENDPOINT='http://127.0.0.1:9000'
# export BRONZE_S3_BUCKET='olist-bronze'
# export AWS_ACCESS_KEY_ID='olist_minio_admin'
# export AWS_SECRET_ACCESS_KEY='local_minio_change_me'

# Warehouse host CLI uses WAREHOUSE_DSN or standard PG* and the same S3 environment.
# export WAREHOUSE_DSN='postgresql://olist_loader:local_loader_change_me@127.0.0.1:5432/olist_source'

# dbt profile reads PGHOST/PGPORT/PGDATABASE/PGUSER and these exported variables.
# export DBT_ENV_SECRET_PASSWORD='local_loader_change_me'
# export DBT_READER_USER='olist_reader'
